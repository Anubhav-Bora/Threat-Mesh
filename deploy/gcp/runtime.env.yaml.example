# Non-secret Cloud Run configuration. Copy this file to runtime.env.yaml,
# replace YOUR_PROJECT_ID, and keep the generated file out of version control.
APP_NAME: "ThreatMesh API"
ENVIRONMENT: "production"
LOG_LEVEL: "INFO"
AUTO_CREATE_SCHEMA: "false"
SCHEDULER_ENABLED: "false"
EXTERNAL_SCHEDULER_ENABLED: "true"
RUN_JOBS_ON_STARTUP: "false"
CORS_ORIGINS: "https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com"
TRUSTED_HOSTS: "*.run.app"
PUBLIC_RATE_LIMIT_PER_MINUTE: "120"
AI_RATE_LIMIT_PER_MINUTE: "12"
LLM_PROVIDER: "gemini"
GEMINI_MODEL: "gemini-3.5-flash-lite"
LLM_TIMEOUT_SECONDS: "25"
FEED_MAX_RESPONSE_BYTES: "8388608"
REPORT_DAY_OF_WEEK: "mon"
REPORT_HOUR_UTC: "6"
GEOLOCATION_ENABLED: "true"
GEOLOCATION_REQUESTS_PER_MINUTE: "40"
