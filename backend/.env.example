# Database
# Docker Compose default (local dev):
DATABASE_URL=postgresql+asyncpg://threatmesh:threatmesh@db:5432/threatmesh
# Vercel/Neon format (example):
# DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:6543/<DB>?ssl=require
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require&channel_binding=require
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Browser/API security. Use JSON or a comma-separated list.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Add deploy origins (for Vercel, add '*.vercel.app' or your custom backend domain).
TRUSTED_HOSTS=localhost,127.0.0.1,backend
# Set a long random value in production. It protects manual mutation endpoints.
ADMIN_API_KEY=

# Jobs and upstream feeds
# Set false for deployments without background cron (for example Vercel API sidecars).
SCHEDULER_ENABLED=true
EXTERNAL_SCHEDULER_ENABLED=false
RUN_JOBS_ON_STARTUP=false
DATA_RETENTION_DAYS=30
ABUSECH_AUTH_KEY=
FEED_SYNC_HOURS=3
FEED_MAX_RESPONSE_BYTES=8388608
ENRICHMENT_INTERVAL_MINUTES=15
ANALYSIS_INTERVAL_HOURS=6
GEOLOCATION_ENABLED=true
GEOLOCATION_REQUESTS_PER_MINUTE=40

# AI: Gemini and OpenRouter send public OSINT prompt context to cloud services.
LLM_PROVIDER=disabled
# Optional explicit fallback, for example: openrouter
LLM_FALLBACK_PROVIDER=disabled
LLM_TIMEOUT_SECONDS=75
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# openrouter/free is best-effort, rate-limited, and not an availability guarantee.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ThreatMesh
# Set LLM_PROVIDER=ollama for local/offline operation.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
