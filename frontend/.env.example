# Browser API path. Nginx and the Vite dev proxy route this to FastAPI.
VITE_API_BASE_URL=/api/v1

# Optional. The app works without a key using an OpenStreetMap-based ArcGIS layer.
# Create a key at https://location.arcgis.com/ if you want Esri basemaps.
# Browser keys are intentionally visible at runtime: restrict the key to your deployed
# referrer/origin in ArcGIS Location Platform. Never treat a VITE_* value as a secret.
VITE_ARCGIS_API_KEY=

# true = always use the bundled, deterministic threat-intelligence demo dataset.
# false = prefer FastAPI. Bundled data appears only when the whole API is unreachable;
# endpoint/application errors surface in the UI and never silently mix sample records.
VITE_DEMO_MODE=false
