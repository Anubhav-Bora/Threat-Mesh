# PostgreSQL / PostGIS
# Local-only defaults. For a shared deployment, change the password here and
# the URL-encoded password in DATABASE_URL together.
POSTGRES_DB=threatmesh
POSTGRES_USER=threatmesh
POSTGRES_PASSWORD=threatmesh
DATABASE_URL=postgresql+asyncpg://threatmesh:threatmesh@db:5432/threatmesh

# Linux bind-mount ownership for versioned rules/reports (use `id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,backend
ADMIN_API_KEY=
PUBLIC_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=12
SCHEDULER_ENABLED=true
RUN_JOBS_ON_STARTUP=false
AUTO_CREATE_SCHEMA=false

# Frontend / ArcGIS (create a restricted browser API key)
VITE_API_BASE_URL=/api/v1
VITE_ARCGIS_API_KEY=
VITE_DEMO_MODE=false

# AI provider: gemini, ollama, or disabled
LLM_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=75

# Optional feed credentials
# Required for live URLhaus and ThreatFox collection. Free at auth.abuse.ch.
ABUSECH_AUTH_KEY=
# Maximum decompressed response body per feed (8 MiB).
FEED_MAX_RESPONSE_BYTES=8388608

# Jobs and enrichment
FEED_SYNC_HOURS=3
ENRICHMENT_INTERVAL_MINUTES=15
ANALYSIS_INTERVAL_HOURS=6
REPORT_DAY_OF_WEEK=mon
REPORT_HOUR_UTC=6
GEOLOCATION_ENABLED=true
GEOLOCATION_REQUESTS_PER_MINUTE=40
